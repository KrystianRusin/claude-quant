{
  "version": {
    "type": "int",
    "min": 1
  },
  "strategy_version": {
    "type": "int",
    "min": 1
  },
  "strategy": {
    "name": {
      "type": "strategy"
    },
    "entry_window_end": {
      "type": "time",
      "min": "09:35",
      "max": "12:00"
    },
    "force_exit_time": {
      "type": "time",
      "min": "15:00",
      "max": "15:50"
    }
  },
  "strategy_params": {
    "opening_range_minutes": {
      "type": "int",
      "min": 5,
      "max": 60
    },
    "stop_loss_r": {
      "type": "float",
      "min": 0.25,
      "max": 1.5
    },
    "take_profit_r": {
      "type": "float",
      "min": 1.0,
      "max": 4.0
    },
    "min_range_pct": {
      "type": "float",
      "min": 0.05,
      "max": 1.0
    },
    "max_range_pct": {
      "type": "float",
      "min": 0.5,
      "max": 5.0
    }
  },
  "risk": {
    "risk_per_trade_pct": {
      "type": "float",
      "min": 0.1,
      "max": 1.0
    },
    "max_trades_per_day": {
      "type": "int",
      "min": 1,
      "max": 12
    },
    "max_daily_loss_pct": {
      "type": "float",
      "min": 0.5,
      "max": 3.0
    },
    "max_position_pct_of_equity": {
      "type": "float",
      "min": 5,
      "max": 25
    }
  },
  "watchlist_rules": {
    "min_symbols": 5,
    "max_symbols": 25,
    "max_adds_per_review": 3,
    "max_removes_per_review": 3,
    "readd_cooldown_days": 10,
    "max_universe_age_days": 4
  },
  "universe": {
    "lookback_days": 20,
    "min_price": 10,
    "min_avg_dollar_volume": 300000000,
    "max_symbols": 300,
    "exchanges": [
      "NYSE",
      "NASDAQ",
      "ARCA",
      "BATS",
      "AMEX"
    ],
    "exclude_name_patterns": [
