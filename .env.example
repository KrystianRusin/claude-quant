# Alpaca PAPER trading keys (https://app.alpaca.markets -> Paper account -> API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Broker backends (see README "Swapping the broker"). Defaults shown.
# BROKER_BACKEND=alpaca     # where orders go: alpaca (paper only) or ibkr (stub)
# DATA_BACKEND=alpaca       # where bars and the calendar come from
# ALLOW_LIVE=               # set to 1 only to let a backend trade a LIVE account
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002            # IB Gateway paper; 4001 is live
# IBKR_CLIENT_ID=17
# IBKR_ACCOUNT=             # DU... for paper
